####
#### [self-host] Single front door for the whole stack.
####
#### Everything — the app and the object storage — is served from one origin so
#### there is exactly one URL to configure (PAPERMARK_URL) and one port to open.
#### That matters more than it looks: S3 presigned URLs are signed for a
#### specific host, and both the browser and the app container have to be able
#### to reach that host. One origin means one answer for both.
####

# Upstreams are resolved at request time, so the proxy still starts if a
# backend is temporarily down.
resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen ${PROXY_PORT};
  server_name _;

  # Uploads are streamed straight through; Papermark handles its own limits.
  client_max_body_size 0;
  proxy_request_buffering off;
  proxy_buffering off;
  proxy_http_version 1.1;

  proxy_connect_timeout 60s;
  proxy_send_timeout    3600s;
  proxy_read_timeout    3600s;

  # Object storage. Presigned URLs are path-style
  # (http://host:9009/<bucket>/<key>?X-Amz-...), so the bucket prefix is what
  # tells the two apart.
  #
  # Host must be forwarded verbatim: MinIO recomputes the SigV4 signature from
  # the Host header it receives, and the client signed it with this one.
  location /${STORAGE_BUCKET}/ {
    set $minio_upstream http://minio:9000;
    proxy_pass $minio_upstream;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Everything else is the Next.js app.
  location / {
    set $app_upstream http://app:3000;
    proxy_pass $app_upstream;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}
