##############################################################################
#  Papermark — self-hosted configuration
#
#  1. cp .env.example .env
#  2. Set PAPERMARK_HOST (see below — this is the one that trips people up)
#  3. Fill in the secrets. On Linux/macOS: ./scripts/generate-secrets.sh
#     On Windows:                          ./scripts/generate-secrets.ps1
#  4. docker compose up -d --build
##############################################################################

##
## WHERE THIS INSTANCE LIVES
##
## PAPERMARK_HOST must be reachable BOTH from your browser AND from inside the
## Docker containers. That rules out `localhost`: inside a container it points
## at the container itself, not at your machine.
##
## Pick one:
##   a) your machine's LAN IP     ->  PAPERMARK_HOST=192.168.1.50
##   b) a hostname you control    ->  PAPERMARK_HOST=papermark.local
##      (the compose file already teaches the containers to resolve it; you
##      only need it in your own hosts file or router DNS)
##
## Changing this later requires a rebuild: docker compose up -d --build
##
PAPERMARK_HOST=papermark.local
PAPERMARK_PORT=9009
PAPERMARK_URL=http://papermark.local:9009

# MinIO's admin console. Storage itself is served through PAPERMARK_PORT.
MINIO_CONSOLE_PORT=9010

##
## SECRETS — replace every one of these before exposing this to anything
##
NEXTAUTH_SECRET=change-me-nextauth-secret
DOCUMENT_PASSWORD_KEY=change-me-document-password-key
VERIFICATION_SECRET=change-me-verification-secret
INTERNAL_API_KEY=change-me-internal-api-key
REVALIDATE_TOKEN=change-me-revalidate-token
POSTGRES_PASSWORD=change-me-postgres-password
REDIS_TOKEN=change-me-redis-token

##
## OBJECT STORAGE (MinIO)
##
STORAGE_ACCESS_KEY=papermark
STORAGE_SECRET_KEY=change-me-storage-secret
STORAGE_BUCKET=papermark-storage
STORAGE_REGION=us-east-1

##
## EMAIL — optional, but you want it
##
## Papermark signs you in with a code sent by email. Without a transport the
## code is printed to the app logs instead (LOG_LOGIN_CODES below), which is
## fine for a private home-lab instance and not fine for anything else.
##
##   docker compose logs -f app | grep "Login code"
##
LOG_LOGIN_CODES=true

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=papermark@example.com
# SMTP_PASSWORD=
# SMTP_FROM=Papermark <papermark@example.com>
# SMTP_SECURE=false
# SMTP_REJECT_UNAUTHORIZED=true

# Or use Resend instead of SMTP (takes precedence when set):
# RESEND_API_KEY=

##
## GOOGLE SIGN-IN — optional
## Authorized redirect URI: ${PAPERMARK_URL}/api/auth/callback/google
##
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

##
## TUNING
##
# How often the worker checks for PDFs waiting to be rendered.
WORKER_INTERVAL_SECONDS=10
